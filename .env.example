# =============================================================================
# Variables de entorno del backend. Copie este archivo a .env y complételo:
#   cp .env.example .env
# .env NUNCA se sube a git. La API valida todo al arrancar y no inicia si falta algo.
# =============================================================================

# development | production | test   (production desactiva Swagger en /docs)
NODE_ENV=development
PUERTO=3000

# URL(s) exactas del frontend, separadas por coma. Sin barra final.
#   Desarrollo:  http://localhost:5173
#   Producción:  https://su-proyecto.vercel.app  (o su dominio propio)
CORS_ORIGENES=http://localhost:5173

# --- MySQL (lo usa docker-compose.yml) ---------------------------------------
# Genere contraseñas con: openssl rand -hex 16
MYSQL_DATABASE=meta_billing
MYSQL_USER=meta_billing
MYSQL_PASSWORD=cambiar_esta_clave
MYSQL_ROOT_PASSWORD=cambiar_esta_clave_root
MYSQL_PORT=3309

# --- Conexión de Prisma ------------------------------------------------------
# Desarrollo: root, porque "prisma migrate dev" crea una base temporal (shadow database).
# Producción: el usuario de la aplicación (MYSQL_USER/MYSQL_PASSWORD); "migrate deploy" no la necesita:
#   DATABASE_URL="mysql://meta_billing:<MYSQL_PASSWORD>@127.0.0.1:3309/meta_billing"
DATABASE_URL="mysql://root:cambiar_esta_clave_root@localhost:3309/meta_billing"

# --- Sesión (JWT) ------------------------------------------------------------
# Mínimo 32 caracteres. Genere uno distinto por entorno con: openssl rand -base64 48
# Cambiarlo invalida todas las sesiones abiertas.
JWT_SECRETO=reemplazar_por_un_secreto_largo_y_aleatorio_de_32+_caracteres
# Duración de la sesión en segundos (28800 = 8 horas)
JWT_EXPIRACION_SEGUNDOS=28800

# --- Proxy inverso -----------------------------------------------------------
# true en producción si la API está detrás de Nginx u otro proxy. Sin esto, el límite de
# intentos de inicio de sesión se compartiría entre todos los usuarios.
CONFIAR_PROXY=false
